generator client {
  provider = "prisma-client"
  output   = "../../generated/query"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  username  String
  email     String
  is_admin  Boolean
  createdAt DateTime

  @@map("user_views")
}

model Movie {
  id        String   @id
  name      String
  genre     String
  duration  Int
  createdAt DateTime

  @@map("movie_views")
}

model Show {
  id             String   @id
  movieId        String
  movieName      String
  genre          String
  theater        String
  startTime      DateTime
  endTime        DateTime
  createdAt      DateTime @default(now())

  @@index([movieId])
  @@index([startTime])
  @@map("show_views")
}

model Reservation {
  id           String   @id
  userId       String
  showId       String
  movieName    String
  theater      String
  startTime    DateTime
  seatNumber   String
  status       String
  expiresAt    DateTime
  createdAt    DateTime
  updatedAt    DateTime @default(now())

  @@index([userId])
  @@index([showId])
  @@map("reservation_views")
}

model Payment {
  id            String   @id
  reservationId String   @unique
  userId        String
  amount        Decimal  @db.Decimal(10, 2)
  status        String
  provider      String?
  transactionId String?
  createdAt     DateTime

  @@index([userId])
  @@map("payment_views")
}

model Notification {
  id        String   @id
  userId    String
  type      String?
  message   String?
  status    String
  createdAt DateTime

  @@index([userId])
  @@map("notification_views")
}
